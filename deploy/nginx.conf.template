# ============================================================
# wmusicbase nginx configuration
# Architecture:
#   /             → player frontend (static)
#   /admin/       → admin frontend (static)
#   /api/         → reverse proxy to FastAPI /api/v1/
#   /media/       → artwork static files (DEBUG only in FastAPI)
#   /music/	  → track static files (DEBUG only in FastAPI)
# ============================================================

upstream wmusicbase_api {
    server 127.0.0.1:8000;
    keepalive 32;
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name music.domain.com;
    return 301 https://$server_name$request_uri;
}

server {
    listen 443 ssl http2;
    server_name music.domain.com;

    charset utf-8;

    ssl_certificate /path/to/cert/of/fullchain.pem;
    ssl_certificate_key /path/to/cert/of/privkey.pem;
    ssl_session_timeout 5m;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-RSA-AES128-GCM-SHA256:ECDHE:ECDH:AES:HIGH:!NULL:!aNULL:!MD5:!ADH:!RC4;
    ssl_prefer_server_ciphers on;

    # -------------------------------------------------------
    # 1. Root = player frontedn (static)
    #    URL: / → serves player dist files
    #    SPA fallback: try files, fallback to /index.html
    # -------------------------------------------------------
    root /var/www/wmusic/player;
    index index.html;

    client_max_body_size 50m;
    client_body_timeout 300s;
    sendfile on;
    sendfile_max_chunk 4m;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 65;

    # -------------------------------------------------------
    # 2. Health check
    # -------------------------------------------------------
    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }    
    
    # -------------------------------------------------------
    # 3. PWA: worker / manifest no cache
    # -------------------------------------------------------
    location ~* ^/(sw\.js|service-worker\.js|workbox-[^/]*\.js|manifest\.webmanifest)$ {
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        expires off;
        try_files $uri =404;
    }

    # -------------------------------------------------------
    # 4. html files should not be cached
    # -------------------------------------------------------
    location ~* \.html$ {
        add_header Cache-Control "no-cache";
        expires 0;
    }

    # -------------------------------------------------------
    # 5. assets can be cached long term
    # -------------------------------------------------------
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    # -------------------------------------------------------
    # 6. Admin frontend (static files)
    #    URL: /admin/ → serves admin dist files
    #    SPA fallback: try files, fallback to /admin/index.html
    # -------------------------------------------------------
    location ^~ /admin/ {
        alias /var/www/wmusic/admin/;
        index index.html;
        try_files $uri $uri/ /admin/index.html;
    }
    location = /admin {
        return 301 /admin/;
    }

    # -------------------------------------------------------
    # 7. API - proxy to FastAPI backend
    #    Frontend calls /api/xxx -> nginx proxies to /api/v1/xxx
    # -------------------------------------------------------
    location ^~ /api/ {
        proxy_pass http://wmusicbase_api/api/v1/;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;

        # SSE / scan progress push：must buffer off, or frontend can not receive incremental events
        proxy_buffering off;
        proxy_cache off;
        chunked_transfer_encoding off;   # SSE used, not affect normal api
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;

        # files/proxy request not restricted; timeout relaxed based on scan task duration
        proxy_request_buffering off;
        add_header X-Accel-Buffering no always;
    }

    # -------------------------------------------------------
    # 8. Artwork static files (served directly by nginx)
    #    In production, FastAPI does NOT serve /media/ (DEBUG=False)
    #    URL: /media/artists/{id}_face.jpg, /media/albums/{id}.jpg, etc.
    # -------------------------------------------------------
    location ^~ /media/ {
        alias /data/media/wmusic/artwork/;  # ← Replace with settings.ARTWORK_DIR

        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options nosniff always;
    }

    # -------------------------------------------------------
    # 9. Music static files (served directly by nginx, range supported naturally)
    #    In production, FastAPI does NOT serve /music/ (DEBUG=False)
    #    URL: /music/ + quote(track.path)
    #    internal: must used; only passed by X-Accel-Request from backend
    # -------------------------------------------------------
    location ^~ /music/ {
        internal;
        alias /data/music/;
        add_header Accept-Ranges bytes always;
        add_header X-Content-Type-Options nosniff always;
        expires 30d;
        limit_rate_after 16m;
        limit_rate 2m;
    }

    location / {
        # SPA history mode fallback
        try_files $uri $uri/ /index.html;
    }

    # Deny access to hidden files
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }
}
