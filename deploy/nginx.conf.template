# ============================================================
# wmusicbase nginx configuration
# Architecture:
#   /             → player frontend (static)
#   /admin/       → admin frontend (static)
#   /api/         → reverse proxy to FastAPI /api/v1/
#   /media/       → artwork static files
#   /music/	      → track static files
# ============================================================

upstream wmusicbase_api {
    server 127.0.0.1:8085;  # ← Replace with actual API port
    keepalive 32;
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# ^~ /admin/ 会跳过所有正则 location，缓存策略只能在块内用变量设置
# map 的正则按出现顺序取第一个命中，\.html$ 必须排在 /admin/assets/ 之前
map $uri $admin_cache_control {
    default                  "public, max-age=86400, must-revalidate";
    ~*\.html$                 "no-cache";
    ~*^/admin/assets/         "public, max-age=31536000, immutable";
}

server {
    listen 80;
    # Replace with the actual domain name
    server_name music.abc.com;
    return 301 https://$server_name:5583$request_uri;
}

server {
    listen 443 ssl http2;
    server_name music.abc.com;

    charset utf-8;
    
    # Replace with the actual cert file path
    ssl_certificate /etc/letsencrypt/live/abc.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/abc.com/privkey.pem;
    ssl_session_timeout 5m;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-RSA-AES128-GCM-SHA256:ECDHE:ECDH:AES:HIGH:!NULL:!aNULL:!MD5:!ADH:!RC4;
    ssl_prefer_server_ciphers on;

    # -------------------------------------------------------
    # 1. Root = player frontedn (static)
    #    URL: / → serves player dist files
    #    SPA fallback: try files, fallback to /index.html
    # -------------------------------------------------------
    root /var/www/wmusic/player;
    index index.html;

    client_max_body_size 50m;
    client_body_timeout 300s;
    sendfile on;
    sendfile_max_chunk 4m;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 65;

    # -------------------------------------------------------
    # 2. Health check
    # -------------------------------------------------------
    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }    
    
    # -------------------------------------------------------
    # 3. PWA: worker / 注册脚本 / manifest 一律不缓存
    # -------------------------------------------------------
    location ~* ^/(sw\.js|registerSW\.js|service-worker\.js|workbox-[^/]*\.js|manifest\.webmanifest)$ {
        expires off;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        try_files $uri =404;
    }

    # -------------------------------------------------------
    # 4. html：允许存储，但每次必须重验证
    #    expires 0 + add_header 会产生两个 Cache-Control，改用 expires off
    # -------------------------------------------------------
    location ~* \.html$ {
        expires off;
        add_header Cache-Control "no-cache" always;
    }

    # -------------------------------------------------------
    # 5a. /assets/* —— Vite 输出的内容哈希文件，可永久缓存
    #     ^~ 优先于下面的扩展名正则；不加 always，避免 404 被 immutable 缓存一年
    # -------------------------------------------------------
    location ^~ /assets/ {
        expires off;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # -------------------------------------------------------
    # 5b. public/ 原样拷贝的无哈希文件（imgs/*.jpg、icons、favicon…）
    #     短 TTL + 强制重验证：换图 / 换图标后老用户仍能拿到新文件
    # -------------------------------------------------------
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|webp|avif|woff|woff2|ttf|eot)$ {
        expires off;
        add_header Cache-Control "public, max-age=86400, must-revalidate";
    }

    # -------------------------------------------------------
    # 6. Admin frontend (static files)
    #    URL: /admin/ → serves admin dist files
    #    SPA fallback: try files, fallback to /admin/index.html
    # -------------------------------------------------------
    location ^~ /admin/ {
        alias /var/www/wmusic/admin/;
        index index.html;
        # ^~ 会跳过上面所有正则 location，缓存策略必须在这里按 URI 单独设置
        # 不加 always：404 不该被长缓存
        add_header Cache-Control $admin_cache_control;
        try_files $uri $uri/ /admin/index.html;
    }
    location = /admin {
        return 301 /admin/;
    }

    # -------------------------------------------------------
    # 7. API - proxy to FastAPI backend
    #    Frontend calls /api/xxx -> nginx proxies to /api/v1/xxx
    # -------------------------------------------------------
    location ^~ /api/ {
        proxy_pass http://wmusicbase_api/api/v1/;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;

        # SSE / scan progress push：must buffer off, or frontend can not receive incremental events
        proxy_buffering off;
        proxy_cache off;
        chunked_transfer_encoding off;   # SSE used, not affect normal api
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;

        # files/proxy request not restricted; timeout relaxed based on scan task duration
        proxy_request_buffering off;
        add_header X-Accel-Buffering no always;
    }

    # -------------------------------------------------------
    # 8. Artwork static files (served directly by nginx)
    #    In production, FastAPI does NOT serve /media/ (DEBUG=False)
    #    URL: /media/artists/{id}_face.jpg, /media/albums/{id}.jpg, etc.
    # -------------------------------------------------------
    location ^~ /media/ {
        alias /data/media/wmusic/artwork/;  # ← Replace with settings.ARTWORK_DIR

        # 封面 URL 带 ?v=<cover_art_hash> 内容版本键，可长缓存
        # 用单一 Cache-Control：expires 1y + add_header 会产生两个同名头
        expires off;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options nosniff always;
    }

    # -------------------------------------------------------
    # 9. Music static files (served directly by nginx, range supported naturally)
    #    In production, FastAPI does NOT serve /music/ (DEBUG=False)
    #    URL: /music/ + quote(track.path)
    #    internal: must used; only passed by X-Accel-Request from backend
    # -------------------------------------------------------
    location ^~ /music/ {
        internal;
        alias /data/music/; # ← Replace with settings.MUSIC_DIR
        add_header Accept-Ranges bytes always;
        add_header X-Content-Type-Options nosniff always;
        expires 30d;
        limit_rate_after 16m;
        limit_rate 2m;
    }

    location / {
        # SPA history mode fallback
        try_files $uri $uri/ /index.html;
    }

    # Deny access to hidden files
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }
}
