# wmusicbase nginx configuration template
# This configuration serves artwork as static files for better performance

# Upstream FastAPI application
upstream wmusicbase_backend {
    server 127.0.0.1:8000;
    keepalive 32;
}

server {
    listen 80;
    server_name your-domain.com;  # Replace with your domain

    # Static files - artwork (served directly by nginx for performance)
    # URL pattern: /media/artists/{id}_face.jpg, /media/artists/{id}_portrait.jpg
    #              /media/albums/{id}.jpg
    #              /media/tracks/{id}.jpg
    #              /media/playlists/{id}.jpg
    location /media/ {
        alias /path/to/media/artwork/;  # Replace with actual ARTWORK_DIR path
        
        # Cache for 1 year (immutable because URL contains hash)
        expires 1y;
        add_header Cache-Control "public, immutable";
        
        # Enable gzip for images (optional, may not help much for already compressed images)
        # gzip on;
        # gzip_types image/jpeg image/png;
        
        # Security headers
        add_header X-Content-Type-Options "nosniff";
        
        # CORS headers (if needed for cross-origin requests)
        # add_header Access-Control-Allow-Origin *;
        
        # Fallback to default images if not found
        # error_page 404 = /media/default/$1.jpg;
    }

    # Default artwork images
    location /media/default/ {
        alias /path/to/media/artwork/default/;  # Replace with actual default artwork path
        expires 1h;
        add_header Cache-Control "public";
    }

    # Audio streaming - requires range support
    location /stream/ {
        proxy_pass http://wmusicbase_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        
        # Range request support for audio seeking
        proxy_set_header Range $http_range;
        proxy_set_header If-Range $http_if_range;
        
        # Buffering settings for streaming
        proxy_buffering off;
        proxy_request_buffering off;
        
        # Timeout settings
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # API and other requests - proxy to FastAPI
    location / {
        proxy_pass http://wmusicbase_backend;
        proxy_http_version 1.1;
        
        # Standard proxy headers
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # WebSocket support (if needed)
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        
        # Timeout settings
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        
        # Buffer settings
        proxy_buffer_size 128k;
        proxy_buffers 4 256k;
        proxy_busy_buffers_size 256k;
    }

    # Health check endpoint
    location /health {
        access_log off;
        return 200 "OK\n";
        add_header Content-Type text/plain;
    }

    # Deny access to hidden files
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }
}
