# ===========================
# app config
# ===========================
APP_NAME=WMusicBase
DEBUG=true

# ===========================
# server config
# ===========================
HOST=0.0.0.0
PORT=8000

# ===========================
# database (PostgreSQL recommended)
# ===========================
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=testuser
DB_PASSWORD=testpwd
DB_NAME=musictestdb

# SQLite development use
# DATABASE_URL=sqlite+aiosqlite:///D:\\tmp\\wmusicbase.db

# ===========================
# music library path (absolute path)
# ===========================
MUSIC_LIBRARY_PATH=D:\\tmp\\testmusiclib
MUSIC_FILE_EXTENSIONS=[".mp3",".flac"]
# Music static prefix for nginx, must be set and be consistent with nginx if use nginx to serve static music files
MUSIC_STATIC_PREFIX=/music/


# ===========================
# media file path (absolute or relative path)
# ===========================
MEDIA_ROOT=.\\media

# ===========================
# security config
# ===========================
SECRET_KEY=your-secret-key-here-change-in-production
ACOUSTID_API_KEY=your-acoustid-api-key-here-change-in-production

# ===========================
# Netease music API config(for import playlist)
# ===========================
NETEASE_COOKIES_FILE=netease_cookies.json
NETEASE_PLAYLIST_API=https://music.163.com/api/v6/playlist/detail
NETEASE_SONG_API=https://interface3.music.163.com/api/v3/song/detail

# ===========================
# cache config(for fetch artwork from LC_NETEASE_API)
# ===========================
TMP_ARTWORK_CACHE_EXPIRE=900                        # Temporary artwork cache expire time in seconds

LC_LRCAPI=http://localhost:28883
LC_LRCAPI_V1=http://localhost:28883/api/v1/lyrics/
LC_NETEASE_API=http://localhost:3000