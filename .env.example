# ===========================
# app config
# ===========================
APP_NAME=WMusicBase
DEBUG=true

# ===========================
# server config
# ===========================
HOST=0.0.0.0
PORT=8000

# ===========================
# database (PostgreSQL recommended)
# ===========================
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=testuser
DB_PASSWORD=testpwd
DB_NAME=musictestdb

# SQLite development use
# DATABASE_URL=sqlite+aiosqlite:///D:\\tmp\\wmusicbase.db

# ===========================
# music library path (absolute path)
# ===========================
MUSIC_LIBRARY_PATH=D:\\tmp\\testmusiclib
MUSIC_FILE_EXTENSIONS=[".mp3",".flac"]

# ===========================
# media file path (absolute or relative path)
# ===========================
MEDIA_ROOT=.\\media

# ===========================
# security config
# ===========================
SECRET_KEY=your-secret-key-here-change-in-production
ACOUSTID_API_KEY=your-acoustid-api-key-here-change-in-production
